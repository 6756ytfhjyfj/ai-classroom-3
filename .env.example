# Copy to .env, then npm run setup generates a private encryption key.
DATABASE_URL="file:./classroom.db"
DATABASE_PROVIDER=sqlite
# Only for standalone demo. Central deployment MUST use admin enrollment.
DEVICE_ENROLLMENT_MODE=open-demo
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
# 32-byte base64 key, never commit or distribute the real value.
ENCRYPTION_KEY=
# Remote trusted deployment MUST set HTTPS and secure cookies.
COOKIE_SECURE=false
# Desktop remote mode: HTTPS origin of a centrally managed server.
CLASSROOM_SERVER_URL=
# Explicit administrator whitelist for custom provider hosts; comma separated.
AI_ALLOWED_HOSTS=api.deepseek.com,generativelanguage.googleapis.com
