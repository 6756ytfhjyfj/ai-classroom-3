# Copy to .env, then npm run setup generates a private encryption key.
DATABASE_URL="file:./classroom.db"
DATABASE_PROVIDER=sqlite
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
# 32-byte base64 key, never commit or distribute the real value.
ENCRYPTION_KEY=
# Remote trusted deployment MUST set HTTPS and secure cookies.
COOKIE_SECURE=false
# Desktop remote mode: HTTPS origin of a centrally managed server.
CLASSROOM_SERVER_URL=https://onclasstime.vercel.app
# Explicit administrator whitelist for custom provider hosts; comma separated.
AI_ALLOWED_HOSTS=api.deepseek.com,generativelanguage.googleapis.com
# content: generateContent (legacy models); interactions: official Interactions
# streaming API (current Gemini models). Interactions requests use store:false.
GEMINI_API_MODE=interactions

# Independent admin site; exact HTTPS origin.
ADMIN_ORIGIN=https://onclasstime-admin.vercel.app
# Set only after uploading and verifying a real release asset.
INSTALLER_DOWNLOAD_URL=
INSTALLER_SHA256=
INSTALLER_SIZE=
