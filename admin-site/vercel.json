{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "installCommand":"cd .. && ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand":"cd .. && npm run build:admin",
  "outputDirectory":"dist",
  "rewrites":[{"source":"/api/:path*","destination":"https://onclasstime.vercel.app/api/:path*"},{"source":"/(.*)","destination":"/index.html"}],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Cache-Control","value":"no-store"}]}]
}
